{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "escape-cats",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-04",
  // Required by Durable Objects on the Workers free plan.
  "compatibility_flags": ["nodejs_compat"],

  // PartyKit's dev default; every client falls back to 127.0.0.1:1999 when
  // VITE_PARTYKIT_HOST is unset.
  "dev": { "port": 1999 },

  // Binding names are WIRE PROTOCOL: routePartykitRequest kebab-cases them
  // into the :party segment of /parties/:party/:room (`Main` -> "main" is
  // partysocket's default party). Don't rename them to match the class names.
  "durable_objects": {
    "bindings": [
      { "name": "Main", "class_name": "HexServer" },
      { "name": "Lobby", "class_name": "LobbyServer" },
      { "name": "Chat", "class_name": "ChatServer" },
      { "name": "Goomba", "class_name": "GoombaServer" }
    ]
  },

  // SQLite-backed DOs — the only type on the free plan. Migrations are
  // APPEND-ONLY and each tag runs once: a new class needs a new tag. Renaming
  // a class orphans every room in it.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HexServer", "LobbyServer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChatServer"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["GoombaServer"]
    }
  ],

  "observability": { "enabled": true }
}
