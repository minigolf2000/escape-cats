{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prototypes",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "prototypes"],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "server"],
      "port": 1999
    },
    {
      "name": "goomba-rider",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/goomba-rider", "--", "--port", "5178", "--strictPort"],
      "port": 5178
    },
    {
      "name": "hex-clicker",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/hex-clicker", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "lobby",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/lobby", "--", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "proctor",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/proctor", "--", "--port", "5175", "--strictPort"],
      "port": 5175
    },
    {
      // The ASSEMBLED production build (run `npm run build:vercel` first) —
      // the only way to see real chunking. Vite's dev server pre-bundles deps
      // and serves modules unsplit, so a dev-mode network log cannot tell you
      // whether ?debug actually avoids fetching the websocket client.
      "name": "built-site",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "dist", "-l", "4180"],
      "port": 4180
    }
  ]
}
