{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // No "WebWorker" here: worker-configuration.d.ts already declares the
    // workerd runtime (WebSocket, Request, DurableObject...), and loading both
    // produces duplicate-identifier errors.
    "lib": ["ES2022"],
    "types": []
  },
  // worker-configuration.d.ts is generated (`npm run typegen`) and gitignored,
  // so `typecheck` regenerates it first — see this workspace's scripts.
  "include": ["src", "worker-configuration.d.ts"]
}
