{
  "name": "escape-cats",
  "private": true,
  "version": "0.1.0",
  "description": "Two cooperative 4-player escape-room mini games starring Hex and Goomba",
  "workspaces": [
    "packages/*",
    "apps/*",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,hex,goomba,proctor,lobby,chat -c blue,magenta,red,green,cyan,yellow \"npm:dev:server\" \"npm:dev:hex\" \"npm:dev:goomba\" \"npm:dev:proctor\" \"npm:dev:lobby\" \"npm:dev:chat\"",
    "dev:server": "npm run dev -w server",
    "dev:hex": "npm run dev -w apps/hex-clicker",
    "dev:goomba": "npm run dev -w apps/goomba-rider",
    "dev:proctor": "npm run dev -w apps/proctor",
    "dev:lobby": "npm run dev -w apps/lobby",
    "dev:chat": "npm run dev -w apps/chat",
    "build": "npm run build --workspaces --if-present",
    "build:vercel": "npm run build --workspaces --if-present && node scripts/assemble.mjs && node scripts/check-routing.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:routing": "node scripts/check-routing.mjs",
    "cf:login": "npm exec -w server -- wrangler login",
    "deploy:server": "npm run deploy -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
