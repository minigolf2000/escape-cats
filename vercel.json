{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ar",
      "has": [
        {
          "type": "host",
          "value": "g00.mba"
        }
      ],
      "permanent": false,
      "destination": "https://cat-games-tau.vercel.app/ar/"
    },
    {
      "source": "/ar/",
      "has": [
        {
          "type": "host",
          "value": "g00.mba"
        }
      ],
      "permanent": false,
      "destination": "https://cat-games-tau.vercel.app/ar/"
    },
    {
      "source": "/ar",
      "has": [
        {
          "type": "host",
          "value": "www.g00.mba"
        }
      ],
      "permanent": false,
      "destination": "https://cat-games-tau.vercel.app/ar/"
    },
    {
      "source": "/ar/",
      "has": [
        {
          "type": "host",
          "value": "www.g00.mba"
        }
      ],
      "permanent": false,
      "destination": "https://cat-games-tau.vercel.app/ar/"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hexxygon.com"
        }
      ],
      "permanent": false,
      "destination": "https://cat-games-tau.vercel.app/hexxygon/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.hexxygon.com"
        }
      ],
      "permanent": false,
      "destination": "https://cat-games-tau.vercel.app/hexxygon/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "g00.mba"
        }
      ],
      "permanent": false,
      "destination": "https://cat-games-tau.vercel.app/g00mBa/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.g00.mba"
        }
      ],
      "permanent": false,
      "destination": "https://cat-games-tau.vercel.app/g00mBa/:path*"
    }
  ],
  "rewrites": [
    {
      "source": "/qr-studio",
      "destination": "/solo-hex/qr-studio.html"
    },
    {
      "source": "/qr-studio/",
      "destination": "/solo-hex/qr-studio.html"
    },
    {
      "source": "/reveal-lab",
      "destination": "/solo-hex/reveal-lab.html"
    },
    {
      "source": "/reveal-lab/",
      "destination": "/solo-hex/reveal-lab.html"
    },
    {
      "source": "/proctor",
      "destination": "/proctor/index.html"
    },
    {
      "source": "/proctor/",
      "destination": "/proctor/index.html"
    }
  ]
}
