{
  "name": "escape-cats",
  "private": true,
  "version": "0.1.0",
  "description": "Two cooperative 4-player escape-room mini games starring Hex and Goomba",
  "workspaces": [
    "packages/*",
    "apps/*",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,hex,goomba,proctor -c blue,magenta,yellow,green \"npm:dev:server\" \"npm:dev:hex\" \"npm:dev:goomba\" \"npm:dev:proctor\"",
    "dev:server": "npm run dev -w server",
    "dev:hex": "npm run dev -w apps/hex-clicker",
    "dev:goomba": "npm run dev -w apps/angry-goomba",
    "dev:proctor": "npm run dev -w apps/proctor",
    "build": "npm run build --workspaces --if-present",
    "build:vercel": "npm run build --workspaces --if-present && node scripts/assemble.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "typescript": "^5.9.3"
  }
}
