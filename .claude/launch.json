{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "goomba-glider",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/goomba-glider", "--", "--port", "5178", "--strictPort"],
      "port": 5178
    },
    {
      "name": "hex-clicker",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/hex-clicker", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      // The ASSEMBLED sites (`npm run build:sites` first) — the only way to see
      // real chunking; dev serves modules unsplit, so it cannot show whether
      // ?debug's panel stays out of the player bundle.
      "name": "built-hex",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "dist/hex", "-l", "4180"],
      "port": 4180
    },
    {
      "name": "built-goomba",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "dist/goomba", "-l", "4181"],
      "port": 4181
    }
  ]
}
